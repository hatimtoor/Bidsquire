    {
      "parameters": {
        "jsCode": "const resp = $('Scrape auction page').first().json;\nconst init = $('Init state').first().json;\nconst lots = resp.lots || [];\n\nif (lots.length === 0) {\n  return [{ json: { _noLots: true, next_page: resp.next_page || null, ...init } }];\n}\n\nreturn lots.map(lot => ({\n  json: {\n    url_main: lot.url,\n    lot_number: lot.lot_number || '',\n    title: lot.title || '',\n    auction_name: resp.auction_name || '',\n    adminId: init.adminId,\n    adminEmail: init.adminEmail,\n    auction_url: init.auction_url,\n    next_page: resp.next_page || null,\n    page: init.page\n  }\n}));"
      },
